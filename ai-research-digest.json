      ],
      "id": "8dd51f70-f155-4047-8f93-020d696a675e",
      "name": "Webhook",
      "webhookId": "4d461e05-6300-4453-8a21-d36dc7cc1d39"
    },
    {
      "parameters": {
        "url": "=https://export.arxiv.org/api/query?search_query={{ $json.body.topic.trim().split(/\\s+/).map(w => 'all:' + encodeURIComponent(w)).join('+AND+') }}&max_results=5&sortBy=submittedDate&sortOrder=descending",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        208,
        0
      ],
      "id": "b72c9a3b-de19-4a79-b0dc-65ea177dbc73",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "n8n-nodes-base.xml",
      "typeVersion": 1,
      "position": [
        416,
        0
      ],
      "id": "180bf335-69a0-4438-abbe-70798d4f64ad",
      "name": "XML"
    },
    {
      "parameters": {
        "jsCode": "const feed = $input.first().json.feed;\nlet entries = feed.entry || [];\nif (!Array.isArray(entries)) entries = [entries];\n\nconst { topic, email } = $('Webhook').first().json.body;\n\nreturn entries.map(e => {\n  const authors = Array.isArray(e.author) ? e.author : [e.author];\n  const links = Array.isArray(e.link) ? e.link : [e.link];\n  const pdf = links.find(l => l.title === 'pdf');\n  return {\n    json: {\n      topic,\n      email,\n      title: e.title.replace(/\\s+/g, ' ').trim(),\n      authors: authors.map(a => a.name).join(', '),\n      published: e.published.slice(0, 10),\n      summary: e.summary.replace(/\\s+/g, ' ').trim(),\n      url: e.id,\n      pdf: pdf ? pdf.href : null,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        0
      ],
      "id": "bed4c670-71a6-4ee1-93b2-f038d05fa281",
      "name": "Clean papers"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You summarise research papers for busy researchers.\n\nResearch topic: {{ $json.topic }}\nTitle: {{ $json.title }}\nAbstract: {{ $json.summary }}\n\nRead the abstract and reply with ONLY one JSON object in exactly this format, with no markdown, no code fences and no extra text:\n\n{\"plain_summary\": \"2-3 sentences that name the dataset, region, method and main numbers from the abstract\", \"method\": \"the main method or model used, in a few words\", \"key_finding\": \"the single most important result, including numbers if the abstract gives them\", \"relevance_score\": 0, \"relevance_reason\": \"one sentence on why this paper matters for the research topic\"}\n\nRules:\n- Fill in every field. Never leave a field out.\n- relevance_score must be a whole number from 1 to 10: 10 means the paper is directly about the research topic, 5 means it is partly related, 1 means it is unrelated. Judge each paper on its own.\n- Use plain text only. Do not use backslashes, LaTeX or maths symbols such as $ or \\sim; write \"about\" or \"approximately\" instead.\n- Use double quotes for all keys and text values.",
        "messages": {
          "messageValues": []
        },
        "batching": {
          "batchSize": 1,
          "delayBetweenBatches": 5000
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        848,
        0
      ],
      "id": "70cfa240-4c10-4cff-9fcc-a91d6d98bcd6",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "jsCode": "// Parse the AI reply for each paper and merge it with the paper's details.\n// Handles code fences, stray backslashes, missing fields and broken JSON.\n\nconst val = (o, k) =>\n  o && o[k] !== undefined && o[k] !== null && String(o[k]).trim() !== ''\n    ? o[k]\n    : 'Not provided';\n\nconst papers = $('Clean papers').all();\n\nreturn $input.all().map((item, i) => {\n  // 1. Get the raw text from the AI\n  let raw = String(item.json.text || '')\n    .replace(/```json|```/g, '')\n    .trim();\n\n  // 2. Keep only the {...} part\n  const start = raw.indexOf('{');\n  const end = raw.lastIndexOf('}');\n  raw = start !== -1 && end > start ? raw.slice(start, end + 1) : '';\n\n  // 3. Fix stray backslashes (e.g. \\sim) that break JSON\n  raw = raw.replace(/\\\\(?![\"\\\\/bfnrtu])/g, '\\\\\\\\');\n\n  // 4. Try to read the JSON\n  let ai = {};\n  let parsed = true;\n  try {\n    ai = JSON.parse(raw);\n  } catch (e) {\n    parsed = false;\n  }\n\n  // 5. Clean the relevance score into a whole number from 1 to 10\n  let score = parseInt(ai.relevance_score, 10);\n  score = Number.isNaN(score) ? null : Math.min(10, Math.max(1, score));\n\n  // 6. Merge with the original paper details\n  const paper = papers[i] ? papers[i].json : {};\n\n  return {\n    json: {\n      ...paper,\n      plain_summary: val(ai, 'plain_summary'),\n      method: val(ai, 'method'),\n      key_finding: val(ai, 'key_finding'),\n      relevance_score: score,\n      relevance_reason: parsed\n        ? val(ai, 'relevance_reason')\n        : 'Could not parse AI output',\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1232,
        16
      ],
      "id": "084d877a-c190-48e5-99b5-511c301e2296",
      "name": "Parse AI output"
    },
    {
      "parameters": {
        "jsCode": "const papers = $input.all().map(i => i.json)\n  .sort((a, b) => (b.relevance_score || 0) - (a.relevance_score || 0));\nconst { topic, email } = papers[0] || {};\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst cards = papers.map(p => `\n<div style=\"margin-bottom:20px;padding-bottom:16px;border-bottom:1px solid #ddd\">\n  <h3 style=\"margin:0 0 4px\"><a href=\"${p.url}\">${esc(p.title)}</a></h3>\n  <p style=\"margin:0;color:#555;font-size:13px\">${esc(p.authors)} | ${p.published} | Relevance: ${p.relevance_score ?? 'n/a'}/10</p>\n  <p><b>Summary:</b> ${esc(p.plain_summary)}</p>\n  <p><b>Method:</b> ${esc(p.method)}</p>\n  <p><b>Key finding:</b> ${esc(p.key_finding)}</p>\n  <p><b>Why it matters:</b> ${esc(p.relevance_reason)}</p>\n</div>`).join('');\n\nreturn [{ json: {\n  email,\n  subject: `Research digest: ${topic} (${papers.length} new papers)`,\n  html: `<h2>Research digest: ${esc(topic)}</h2>${cards}`\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
